NODE_ENV=development
PORT=3000
JWT_SECRET=replace-with-at-least-32-random-bytes
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_app_user
DB_PASSWORD=replace-with-a-unique-database-password
DB_NAME=app_roles
DB_CONNECTION_LIMIT=10
# Set only when running behind a trusted reverse proxy. Example: 1
TRUST_PROXY=0
